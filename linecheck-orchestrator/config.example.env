# LineCheck Orchestrator config — copy to .env and fill in. NEVER commit the filled copy.
# Loaded by systemd via EnvironmentFile=.

# --- GitHub identity ---------------------------------------------------------
# GH_REPO is the LEDGER repo the webhook watches (the one holding exchange/attention/).
# An envelope's exact_product_repo (e.g. derickonfire/linecheck-acceptance) is a
# field inside envelopes and is NOT what you watch here.
GH_REPO=derickonfire/emotivus-forge
INBOX_ISSUE=0
ATTENTION_PREFIX=exchange/attention/

# Installation access token from the GitHub App (preferred) OR a fine-grained PAT
# scoped to GH_REPO with Contents:read + Issues:read. Required to fetch envelopes
# and to run the reconcile backstop. Keep out of git.
GH_TOKEN=

# Shared secret you set on the GitHub App webhook. Enables HMAC verification of
# every incoming delivery. Strongly recommended — without it, verification is OFF.
GH_WEBHOOK_SECRET=

# --- Agent launchers ---------------------------------------------------------
# Absolute path to the script that starts each lane's headless agent. The
# orchestrator runs these with EVENT_ID / EVENT_PATH / EVENT_COMMIT / LANE /
# ORCH_URL in the environment. Leave blank to run in observe-only mode (the
# service will log "would launch ..." but start nothing).
CLAUDE_LAUNCH_CMD=/home/YOUR_USER/linecheck-orchestrator/launchers/launch_claude.sh
CODEX_LAUNCH_CMD=/home/YOUR_USER/linecheck-orchestrator/launchers/launch_codex.sh

# --- Tuning ------------------------------------------------------------------
RECONCILE_INTERVAL_SECONDS=120
HEARTBEAT_STALE_SECONDS=45
LEASE_DEFAULT_SECONDS=2100
PORT=8787
STATE_DIR=/home/YOUR_USER/.linecheck-orchestrator
SELF_URL=http://127.0.0.1:8787
